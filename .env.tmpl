# Optional. Preserves sessions across container restarts.
WEBUI_SECRET_KEY=make one up

# AWS Bedrock access. Required to access AWS Bedrock models.
OPENWEBUI_AWS_ACCESS_KEY_ID=your AWS IAM keys
OPENWEBUI_AWS_SECRET_ACCESS_KEY=your AWS IAM keys
OPENWEBUI_AWS_REGION=your AWS region

# Required to access Bedrock embeddings or Anthropic models via LiteLLM.
LITELLM_MASTER_KEY=make one up

# Anthropic API access (via litellm)
OPENWEBUI_ANTHROPIC_API_KEY=your Anthropic API key

# Tailscale key for one time Caddy Tailscale node provisioning
CADDY_TS_AUTHKEY=your-tailscale-authkey
CADDY_TAILNET_ID=your-tailnet-id
